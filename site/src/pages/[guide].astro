---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import StructuredData from '../components/StructuredData.astro';
import { Button } from '../components/Button/Button';
import { FAQ } from '../components/FAQ/FAQ';
import { TableOfContents } from '../components/DocLayout/TableOfContents';
import { guideRoutes } from '../data/guides';
import '../styles/prose.css';
import '../styles/guides.css';

export async function getStaticPaths() {
  const entries = [...await getCollection('compare'), ...await getCollection('guides')];
  if (entries.length !== guideRoutes.length || entries.some((entry) => !guideRoutes.some(({ slug }) => slug === entry.id))) {
    throw new Error('Every dated content entry must match the public guide/sitemap catalog');
  }
  return entries.map((entry) => ({ params: { guide: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'compare'> | CollectionEntry<'guides'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const contents = headings.filter(({ depth }) => depth === 2 || depth === 3)
  .map(({ slug, text, depth }) => ({ id: slug, text, depth: depth === 3 ? 3 as const : 2 as const }));
const { title, description, heading, eyebrow, verified, sources, faqs } = entry.data;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const url = new URL(`${base}${entry.id}/`, Astro.site).href;
---
<Base title={title} description={description}>
  <main id="main" class="document container guide-document">
    <nav class="guide-breadcrumb" aria-label="Breadcrumb"><a href={base}>Saydraft</a><span aria-hidden="true">/</span><span>{heading}</span></nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <p class="guide-verified">Facts checked <time datetime={verified}>{verified}</time>. Product plans and features can change.</p>
    <TableOfContents headings={contents} />
    <article class="guide-copy"><Content /></article>
    {faqs.length > 0 && <section class="guide-faq" aria-labelledby="guide-questions"><h2 id="guide-questions">A few useful answers.</h2><FAQ questions={faqs.map(({ q, a }) => ({ question: q, answer: a }))} /></section>}
    <section class="guide-sources" aria-labelledby="guide-sources"><h2 id="guide-sources">Sources and further reading</h2><ul>{sources.map((source) => <li><a href={source.url}>{source.label} ↗</a></li>)}</ul></section>
    <aside class="guide-next"><h2>Try it with your own words.</h2><p>Saydraft is in development and available from source. Review the setup status, model sizes and measured limits before choosing it for your workflow.</p><Button href={`${base}download/`}>Get Saydraft</Button></aside>
    <nav class="guide-related" aria-label="More guides"><h2>Keep reading.</h2><ul>{guideRoutes.filter(({ slug }) => slug !== entry.id).map((guide) => <li><a href={`${base}${guide.slug}/`}>{guide.name}</a></li>)}</ul></nav>
  </main>
  <StructuredData data={{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Saydraft', item: new URL(base, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: heading, item: url },
  ] }} />
  {faqs.length > 0 && <StructuredData data={{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }} />}
</Base>
