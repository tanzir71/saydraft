/* Generated by tools/generate_tokens.mjs; edit design/app-tokens.json. */
/* Font sizes/weights are applied from live application-font ratios, not frozen px. */
QWidget { background-color: #121211; color: #EDEDE8; }
QWidget[bare="true"] { background: transparent; }
QLabel, QCheckBox, QRadioButton, QToolButton { background: transparent; }
QFrame, QScrollArea { border: none; }
QFrame[card="true"], QWidget[card="true"] { background: #1B1B1A; border: 1px solid rgba(237,237,232,23); border-radius: 14px; }
QFrame[modelChoice="true"][selected="true"] { border: 2px solid #EDEDE8; }
QWizardPage { background: #1B1B1A; }
QFrame[field="true"] { background: #252523; border-radius: 10px; }
QFrame[row="true"] { background: transparent; border-top: 1px solid rgba(237,237,232,23); }
QFrame[rowFirst="true"] { border: none; }
QLabel[role="muted"], QLabel[role="small"], QLabel[role="caption"], QLabel[role="label"], QLabel[role="eyebrow"] { color: #9C9B95; }
QLabel[role="title"], QLabel[role="setupTitle"], QLabel[role="heading"], QLabel[role="display"] { font-family: "Familjen Grotesk"; }
QLabel[role="label"], QLabel[role="eyebrow"] { font-family: "Martian Mono"; }
QLabel[role="readout"] { font-family: "Doto"; }
QLabel[keycap="true"] { color: #EDEDE8; background: #1B1B1A; border: 1px solid rgba(237,237,232,23); border-bottom-width: 2px; border-radius: 6px; padding: 2px 7px; min-height: 16px; }
QLabel[keycap="true"][bar="true"] { background: #232321; color: #EDEDE8; border-color: rgba(237,237,232,31); }
QLabel[badge] { border-radius: 11px; padding: 3px 9px 3px 8px; background: #252523; color: #9C9B95; }
QLabel[badge="signal"] { background: #3B211A; color: #FF9C85; }
QLabel[badge="ok"] { background: #16301F; color: #5FBF86; }
QLabel[badge="warn"] { background: #3A2A12; color: #F2A33A; }
QLabel[badge="danger"] { background: #3D1C19; color: #F97066; }
QPushButton { background: transparent; color: #EDEDE8; border: 1px solid rgba(237,237,232,23); border-radius: 18px; padding: 7px 16px; min-height: 20px; }
QPushButton[size="s"] { border-radius: 15px; padding: 5px 12px; min-height: 18px; }
QPushButton[primary="true"] { background: #EDEDE8; color: #0F0F0E; border: 1px solid #EDEDE8; }
QPushButton[ghost="true"] { border-color: transparent; }
QPushButton[danger="true"] { background: #3D1C19; color: #F97066; border-color: transparent; }
QPushButton:hover, QToolButton:hover { background: #2C2C2A; }
QPushButton[primary="true"]:hover { background: #9C9B95; border-color: #9C9B95; }
QPushButton:disabled, QToolButton:disabled { color: #62615C; }
QPushButton[primary="true"]:disabled { background: #2C2C2A; border-color: #2C2C2A; color: #62615C; }
QPushButton[keyboardFocus="true"]:focus, QToolButton[keyboardFocus="true"]:focus, QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus { border: 2px solid #EDEDE8; }
QToolButton { border: 1px solid transparent; border-radius: 8px; padding: 6px; }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #252523; color: #EDEDE8; border: 2px solid transparent; border-radius: 10px; padding: 6px 10px; min-height: 20px; selection-background-color: #EDEDE8; selection-color: #0F0F0E; }
QLineEdit[search="true"] { background: #1B1B1A; border: 1px solid rgba(237,237,232,23); }
QLineEdit[search="true"]:focus { border: 2px solid #EDEDE8; }
QTextEdit[reader="true"], QPlainTextEdit[reader="true"] { background: transparent; border: none; padding: 0; }
QTextEdit[reader="true"]:focus, QPlainTextEdit[reader="true"]:focus { border: 2px solid #EDEDE8; }
QFrame[segmented="true"] { background: #252523; border-radius: 10px; }
QFrame[segmented="true"][onBackground="true"] { background: #2C2C2A; }
QRadioButton[segment="true"], QPushButton[segment="true"] { background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 5px 12px; color: #9C9B95; }
QRadioButton[segment="true"]::indicator { width: 0; height: 0; border: none; }
QRadioButton[segment="true"]:checked, QPushButton[segment="true"]:checked { background: #1B1B1A; color: #EDEDE8; }
QRadioButton[segment="true"][keyboardFocus="true"]:focus, QPushButton[segment="true"][keyboardFocus="true"]:focus { border: 2px solid #EDEDE8; }
QGroupBox { background: #1B1B1A; border: 1px solid rgba(237,237,232,23); border-radius: 14px; margin-top: 20px; padding: 16px; }
QGroupBox::title { subcontrol-origin: margin; padding-left: 8px; }
QWidget#dictionaryToast { background: #1B1B1A; border: 1px solid rgba(237,237,232,23); border-radius: 14px; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: #121211; color: #9C9B95; padding: 8px 12px; }
QTabBar::tab:selected { background: #1B1B1A; color: #EDEDE8; }
QListWidget { background: transparent; border: 2px solid transparent; border-radius: 10px; selection-background-color: #252523; selection-color: #EDEDE8; }
QListWidget:focus { border-color: transparent; }
QListWidget[keyboardFocus="true"]::item:focus { border-color: #EDEDE8; }
QListWidget::item { padding: 8px 10px; border: 1px solid transparent; border-radius: 10px; color: #9C9B95; }
QListWidget::item:selected { background: #232321; color: #EDEDE8; border-color: rgba(237,237,232,23); }
QPushButton[navButton="true"] { text-align: left; border-radius: 10px; padding: 8px 10px; }
QPushButton[navButton="true"]:checked { background: #1B1B1A; color: #EDEDE8; border: 1px solid rgba(237,237,232,23); }
QPushButton[navButton="true"][keyboardFocus="true"]:focus { border: 2px solid #EDEDE8; }
QListWidget#hubNavigation::item { min-height: 18px; padding: 8px 10px; }
QListWidget#settingsSections::item { min-height: 16px; padding: 6px 12px; border-radius: 8px; }
QListWidget#settingsSections::item:selected { background: #1B1B1A; }
QListWidget[results="true"] { background: #1B1B1A; }
QListWidget[results="true"]::item:selected { background: #252523; border-color: transparent; }
QListWidget[languageTiles="true"]::item { background: #1B1B1A; border: 1px solid rgba(237,237,232,23); border-radius: 10px; padding: 12px; }
QListWidget[languageTiles="true"]::item:checked { background: #3B211A; color: #FF9C85; }
QListWidget[languageTiles="true"]::indicator { width: 18px; height: 18px; background: #1B1B1A; border: 1px solid #9C9B95; border-radius: 4px; }
QListWidget[languageTiles="true"]::indicator:checked { background: #EDEDE8; border-color: #EDEDE8; image: url(saydraftTheme:check-dark.svg); }
QTableView, QTreeView { background: #1B1B1A; alternate-background-color: #1B1B1A; selection-background-color: #252523; selection-color: #EDEDE8; gridline-color: transparent; border: none; }
QHeaderView::section { background: #1B1B1A; color: #9C9B95; border: none; border-bottom: 1px solid rgba(237,237,232,23); padding: 10px 16px; }
QCheckBox, QRadioButton { border: 2px solid transparent; padding: 2px; }
QCheckBox[keyboardFocus="true"]:focus, QRadioButton[keyboardFocus="true"]:focus { border-color: #EDEDE8; border-radius: 4px; }
QCheckBox::indicator, QRadioButton::indicator { width: 18px; height: 18px; background: #1B1B1A; border: 1px solid #9C9B95; border-radius: 4px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked { background: #EDEDE8; border-color: #EDEDE8; image: url(saydraftTheme:check-dark.svg); }
QRadioButton::indicator:checked { image: url(saydraftTheme:radio-dark.svg); }
QCheckBox[toggle="true"] { border: none; padding: 0; }
QCheckBox[toggle="true"]::indicator { width: 0; height: 0; border: none; }
QWidget:disabled { color: #62615C; }
QProgressBar { border: none; background: #2C2C2A; border-radius: 3px; text-align: center; }
QProgressBar::chunk { background: #EDEDE8; border-radius: 3px; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url(saydraftTheme:down-dark.svg); width: 12px; height: 12px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; border: none; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; border: none; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(saydraftTheme:up-dark.svg); width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(saydraftTheme:down-dark.svg); width: 10px; height: 10px; }
QMenu { background: #1B1B1A; color: #EDEDE8; border: 1px solid rgba(237,237,232,23); border-radius: 10px; padding: 6px 0; }
QMenu::item { padding: 8px 14px 8px 12px; }
QMenu::item:selected { background: #252523; }
QMenu::separator { height: 1px; background: rgba(237,237,232,23); margin: 4px 0; }
QToolTip { background: #EDEDE8; color: #0F0F0E; border: none; border-radius: 6px; padding: 4px 8px; }
QScrollBar:vertical { width: 10px; background: transparent; }
QScrollBar::handle:vertical { background: #2C2C2A; border-radius: 5px; min-height: 32px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QFrame[saveBar="true"] { background: #EDEDE8; color: #0F0F0E; border-radius: 24px; }
QFrame[saveBar="true"] QLabel { color: #0F0F0E; }
QFrame[saveBar="true"] QPushButton { color: #0F0F0E; border-color: transparent; }
QFrame[saveBar="true"] QPushButton[primary="true"] { background: #0F0F0E; color: #EDEDE8; border-color: #0F0F0E; }
QFrame[saveBar="true"] QPushButton[keyboardFocus="true"]:focus { border: 2px solid #0F0F0E; }
QFrame[inverse="true"] { background: #EDEDE8; color: #0F0F0E; border-radius: 14px; }
QFrame[inverse="true"] QLabel { color: #0F0F0E; background: transparent; }
QFrame[setupStage="true"] { background: #121211; border-radius: 16px; }
QFrame[preview="true"] { background: #1B1B1A; border: 1px solid #EDEDE8; border-radius: 12px; }
