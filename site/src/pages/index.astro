---
import Base from '../layouts/Base.astro';
import { Button } from '../components/Button/Button';
import { BarDemo } from '../components/BarDemo/BarDemo';
import { BeforeAfterCard } from '../components/BeforeAfterCard/BeforeAfterCard';
import { FAQ } from '../components/FAQ/FAQ';
import '../styles/home.css';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const questions = [
  { question: 'Does my voice leave my PC?', answer: 'Speech recognition and text cleanup run locally. Saydraft has no cloud transcription, telemetry, or account. Model downloads happen only when you start them during setup.' },
  { question: 'Do I need the internet to get started?', answer: 'Yes, once: choose the recommended models, review their sizes and licenses, and start the setup download. You can pause and resume. Later launches reuse the installed models offline.' },
  { question: 'Can I dictate in Bengali or Arabic?', answer: 'Yes, through the optional shared All languages model. Install that model once for both languages. Choosing a language never starts a download by itself.' },
  { question: 'Do I need a powerful graphics card?', answer: 'Speech recognition can run on the CPU. Hardware and model choice affect speed; optional AI cleanup requires more resources. The performance check helps choose a suitable setup, including rules-only cleanup.' },
  { question: 'Where can I use it?', answer: 'Saydraft inserts text at the cursor in editable Windows apps. Password fields are excluded. Some protected or elevated apps need extra care; start with an ordinary text editor.' },
  { question: 'Can I change how my words are cleaned up?', answer: 'Choose a tone and cleanup intensity for each app group, add names to your dictionary, and create spoken snippets. Raw mode preserves your transcript without prose cleanup.' },
  { question: 'Is it free?', answer: 'Saydraft is free and open source under the MIT license. Speech and cleanup models have their own licenses, shown before download and listed in the project credits.' },
  { question: 'Is this page listening to me?', answer: 'No. The example is a canned simulation. This website does not request microphone access, upload audio, or use tracking analytics.' },
];
---
<Base title="Saydraft — Free offline dictation for Windows" description="Speak naturally and turn your words into clear text on your own PC. Saydraft is free, open-source offline dictation for Windows, with local speech recognition and cleanup.">
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-top"><p class="eyebrow">Offline dictation for Windows</p><span class="hero-note"><span aria-hidden="true">✳</span> A little less typing.<br />A little more you.</span></div>
      <h1 id="hero-title">Speak messy.<br /><em>Paste polished.</em></h1>
      <div class="hero-bottom"><p>Let your thoughts out.<br />We’ll help you find the words.<br /><span class="muted">Free voice typing. All on your PC.</span></p><div class="hero-actions"><Button href={`${base}download/`}>Get Saydraft for Windows</Button><span>Windows 10 &amp; 11 · No account needed</span></div></div>
      <div class="voice-scene" data-demo-scene>
        <svg class="ribbon" viewBox="0 0 1100 210" fill="none" aria-hidden="true"><defs><path id="voice-path" d="M-20 100C130-20 340 215 545 100S875-5 1130 100" /></defs><text><textPath href="#voice-path" startOffset="1%">um, let’s meet at two… actually, make that three. just a quick coffee?</textPath></text></svg>
        <div class="scene-bar"><BarDemo state="idle" /></div>
        <div class="scene-result"><span class="eyebrow">Your words, a little clearer</span><p data-demo-result>Let’s meet at 3.<br />Just a quick coffee?</p><span class="edit-chip">Backtrack: 2 → 3</span></div>
        <button type="button" class="play-example" data-demo-play>Play the example <span aria-hidden="true">↗</span></button>
        <span class="simulation-note">Illustrative simulation · no microphone</span>
        <span class="sr-only" role="status" data-demo-status></span>
      </div>
    </section>
    <section class="credits-sheet" aria-label="Built on open models"><div class="container"><p class="eyebrow">Built on open models. Built in the open.</p><div class="model-names"><span>NVIDIA Parakeet</span><span>Whisper</span><span>Qwen</span><span>llama.cpp</span><span>sherpa-onnx</span></div><a href={`${base}credits/`}>Meet the building blocks <span aria-hidden="true">↗</span></a></div></section>
    <section class="thought-sheet" aria-labelledby="thought-title"><div class="container thought-grid"><div><p class="eyebrow">Less friction. More flow.</p><h2 id="thought-title">For the way<br />you <em>actually think.</em></h2></div><div class="thought-copy"><span class="asterisk" aria-hidden="true">✳</span><p>Half a thought. A change of plan. That word you always stumble over.</p><p>You don’t have to speak in perfect sentences to put something good on the page.</p><a href={`${base}docs/getting-started/`}>Find your flow <span aria-hidden="true">↗</span></a></div></div></section>
    <section class="section container" id="features" aria-labelledby="edits-title"><div class="section-heading"><p class="eyebrow">A small edit. A clearer thought.</p><h2 id="edits-title">Say it your way.<br /><em>Leave the tidying to us.</em></h2><p class="muted">Illustrative cleanup examples. Your words stay yours.</p></div><div class="edit-grid"><BeforeAfterCard title="Change your mind." before="Let’s meet at two… actually, make that three." after="Let’s meet at 3." chip="Backtrack: 2 → 3" /><BeforeAfterCard title="Find your rhythm." before="Um, I think, uh, this could work." after="I think this could work." chip="Removed hesitation" /><BeforeAfterCard title="Make a little space." before="First item, send the notes. Second item, book the room." after={'• Send the notes\n• Book the room'} chip="Made a list" /></div></section>
    <section class="section container tools-section" aria-labelledby="tools-title"><div><p class="eyebrow">Built around how you write</p><h2 id="tools-title">Your voice.<br /><em>Your kind of words.</em></h2></div><div class="feature-list"><article><span class="feature-number">01</span><div><h3>A tone for every place.</h3><p>A thoughtful email. A quick reply. Set tone and cleanup intensity for the apps you use.</p></div></article><article><span class="feature-number">02</span><div><h3>The names that matter.</h3><p>Add people, places, and specialist terms to your dictionary. Keep the details familiar.</p></div></article><article><span class="feature-number">03</span><div><h3>Say a little. Write a lot.</h3><p>Turn your everyday phrases into snippets. A short cue can become your full sign-off.</p></div></article><article><span class="feature-number">04</span><div><h3>More than one language.</h3><p>Multilingual speech recognition, with Bengali and Arabic available through the shared All languages model.</p></div></article></div></section>
    <section class="container shortcut-card" aria-labelledby="shortcuts-title"><div><p class="eyebrow">Right at your fingertips</p><h2 id="shortcuts-title">A familiar<br /><em>little shortcut.</em></h2></div><div class="shortcuts"><p><span><kbd>Ctrl</kbd> + <kbd>Win</kbd></span><span>Hold to speak</span></p><p><span><kbd>Ctrl</kbd> + <kbd>Win</kbd> + <kbd>Space</kbd></span><span>Go hands-free</span></p><p><span><kbd>Shift</kbd> + <kbd>Alt</kbd> + <kbd>Z</kbd></span><span>Paste your last words</span></p></div></section>
    <section class="section container privacy-section" aria-labelledby="privacy-title"><p class="eyebrow">A private train of thought</p><h2 id="privacy-title">Your voice.<br /><em>Your machine.</em><br />Nobody else’s business.</h2><div class="privacy-bottom"><p>Speech and cleanup run on your PC.<br />No account. No cloud transcription.<br />No tracking, in the app or on this site.</p><a href={`${base}privacy/`}>See how it stays local <span aria-hidden="true">↗</span></a></div></section>
    <section class="section container faq-section" id="questions" aria-labelledby="faq-title"><div><p class="eyebrow">A few good questions</p><h2 id="faq-title">Glad you<br /><em>asked.</em></h2></div><FAQ questions={questions} /></section>
    <section class="final-sheet" aria-labelledby="final-title"><div class="container"><p class="eyebrow">Make room for your next thought</p><h2 id="final-title">Less keyboard.<br /><em>More possibility.</em></h2><Button href={`${base}download/`} variant="on-dark">Get Saydraft for Windows</Button><p>Free. Open source. Yours to make your own.</p></div></section>
  </main>
<script>
  const scene = document.querySelector<HTMLElement>('[data-demo-scene]');
  const play = scene?.querySelector<HTMLButtonElement>('[data-demo-play]');
  const bar = scene?.querySelector<HTMLElement>('[data-bar-demo]');
  const label = scene?.querySelector<HTMLElement>('[data-bar-label]');
  const status = scene?.querySelector<HTMLElement>('[data-demo-status]');
  const result = scene?.querySelector<HTMLElement>('[data-demo-result]');
  play?.addEventListener('click', async () => {
    if (!bar || !label || !status || !result || play.disabled) return;
    play.disabled = true;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const [state, text, delay] of [['listening', 'Listening', 1100], ['cleaning', 'Tidying your words', 600], ['inserted', 'Words, delivered', 0]] as const) {
      bar.dataset.state = state;
      bar.setAttribute('aria-label', `Saydraft example: ${text}`);
      label.textContent = text;
      result.style.opacity = state === 'inserted' ? '1' : '.35';
      if (delay && !reduced) await new Promise((resolve) => window.setTimeout(resolve, delay));
    }
    status.textContent = 'Example finished. Let’s meet at 3. Just a quick coffee?';
    play.disabled = false;
  });
</script>
</Base>
