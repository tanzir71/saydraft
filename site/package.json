{
  "name": "saydraft-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "tokens": "node ../tools/generate_tokens.mjs",
    "tokens:check": "node ../tools/generate_tokens.mjs --check",
    "content:check": "node tools/check-content-dates.mjs",
    "content:test": "node --test tools/content-verification.test.mjs tools/releases.test.mjs",
    "build": "npm run tokens:check && npm run content:check && astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@astrojs/react": "7.1.8",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "astro": "7.4.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.0",
    "@storybook/react-vite": "10.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "html-validate": "11.21.0",
    "storybook": "10.6.7",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
