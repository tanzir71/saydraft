---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import StructuredData from '../components/StructuredData.astro';
import { Button } from '../components/Button/Button';
import { FAQ } from '../components/FAQ/FAQ';
import { TableOfContents } from '../components/DocLayout/TableOfContents';
import { guideRoutes } from '../data/guides';
import { documentationRoutes } from '../data/documentation';
import { applicationSchema, creatorSchema } from '../data/application';
import '../styles/prose.css';
import '../styles/guides.css';

interface Props { entry: CollectionEntry<'compare' | 'guides' | 'docs' | 'pages'>; path: string; }
const { entry, path } = Astro.props;
const { Content, headings } = await render(entry);
const contents = headings.filter(({ depth }) => depth === 2 || depth === 3)
  .map(({ slug, text, depth }) => ({ id: slug, text, depth: depth === 3 ? 3 as const : 2 as const }));
const { title, description, heading, emphasis, eyebrow, verified, sources, faqs } = entry.data;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const url = new URL(`${base}${path}/`, Astro.site).href;
const documentation = entry.collection === 'docs';
const breadcrumb = [
  { name: 'Saydraft', item: new URL(base, Astro.site).href },
  ...(documentation && path !== 'docs' ? [{ name: 'Docs', item: new URL(`${base}docs/`, Astro.site).href }] : []),
  { name: heading, item: url },
];
const next = path === 'download'
  ? { title: 'Ready for your first few words?', path: 'docs/getting-started/', label: 'Read the setup guide', text: 'Choose a compatible model, review its size and license, then try a short draft.' }
  : { title: 'Try it with your own words.', path: 'download/', label: 'Get Saydraft', text: 'Download the unsigned Windows preview. Review setup, model sizes and measured limits before choosing it for your workflow.' };
const related = documentation ? documentationRoutes.filter((route) => route.slug !== path) : guideRoutes.filter((route) => route.slug !== path);
---
<Base title={title} description={description}>
  <main id="main" class="document container guide-document">
    <nav class="guide-breadcrumb" aria-label="Breadcrumb">{breadcrumb.map((item, index) => <>{index > 0 && <span aria-hidden="true">/</span>}{index < breadcrumb.length - 1 ? <a href={new URL(item.item).pathname}>{item.name}</a> : <span>{item.name}</span>}</>)}</nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{emphasis ? <>{heading.slice(0, -emphasis.length)}<em>{emphasis}</em></> : heading}</h1>
    <p class="guide-verified">Facts checked <time datetime={verified}>{verified}</time>. Product plans and features can change.</p>
    {documentation && <nav class="docs-navigation" aria-label="Documentation"><ul>{documentationRoutes.map((route) => <li><a href={`${base}${route.slug}/`} aria-current={route.slug === path ? 'page' : undefined}>{route.name}</a></li>)}</ul></nav>}
    {contents.length > 0 && <TableOfContents headings={contents} />}
    <article class="guide-copy"><Content /></article>
    {faqs.length > 0 && <section class="guide-faq" aria-labelledby="guide-questions"><h2 id="guide-questions">A few useful answers.</h2><FAQ questions={faqs.map(({ q, a }) => ({ question: q, answer: a }))} /></section>}
    <section class="guide-sources" aria-labelledby="guide-sources"><h2 id="guide-sources">Sources and further reading</h2><ul>{sources.map((source) => <li><a href={source.url}>{source.label} ↗</a></li>)}</ul></section>
    <aside class="guide-next"><h2>{next.title}</h2><p>{next.text}</p><Button href={`${base}${next.path}`}>{next.label}</Button></aside>
    <nav class="guide-related" aria-label="More guides"><h2>Keep reading.</h2><ul>{related.map((guide) => <li><a href={`${base}${guide.slug}/`}>{guide.name}</a></li>)}</ul></nav>
  </main>
  <StructuredData data={{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumb.map((item, index) => ({ '@type': 'ListItem', position: index + 1, ...item })) }} />
  {faqs.length > 0 && <StructuredData data={{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }} />}
  {['download', 'offline-dictation-windows'].includes(path) && <StructuredData data={applicationSchema(Astro.site!, base)} />}
  {path === 'credits' && <StructuredData data={creatorSchema(Astro.site!, base)} />}
</Base>
