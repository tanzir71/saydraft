/* Generated by tools/generate_tokens.mjs; edit design/tokens.json. */
QWidget { background-color: #F5F2E9; color: #141414; }
QToolTip, QMenu, QGroupBox { background-color: #ECE7DA; color: #141414; }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
  background-color: #ECE7DA; color: #141414; border: none;
  border-radius: 8px; padding: 8px; selection-background-color: #141414;
  selection-color: #F5F2E9;
}
QPushButton { background-color: #ECE7DA; color: #141414; border: none; border-radius: 12px; padding: 10px 16px; }
QPushButton[primary="true"], QPushButton:checked { background-color: #141414; color: #F5F2E9; }
QPushButton:hover { background-color: #DDE6F6; color: #141414; }
QPushButton:focus, QLineEdit:focus, QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
  border: 2px solid #141414;
}
QWidget:disabled { color: #5B5A55; }
QLabel[role="muted"] { color: #5B5A55; }
QLabel[role="display"] { font-family: "Instrument Serif"; font-size: 34px; }
QLabel[role="eyebrow"] { font-family: "Geist Mono"; font-size: 12px; }
QProgressBar { border: none; background-color: #ECE7DA; color: #141414; border-radius: 6px; text-align: center; }
QProgressBar::chunk { background-color: #141414; border-radius: 6px; }
QTabBar::tab { padding: 10px 16px; background-color: #F5F2E9; color: #5B5A55; }
QTabBar::tab:selected { background-color: #ECE7DA; color: #141414; }
QScrollArea, QFrame { border: none; }
