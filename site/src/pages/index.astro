---
import Base from '../layouts/Base.astro';
import { currentRelease } from '../data/current-release';
import { Button } from '../components/Button/Button';
import { Mark } from '../components/Mark/Mark';
import { FAQ } from '../components/FAQ/FAQ';
import { PrivacyFacts } from '../components/PrivacyFacts/PrivacyFacts';
import { CompareTable } from '../components/CompareTable/CompareTable';
import { SectionHeader, InstrumentPanel, FactsSheet, HowItWorks, ProofSheet, FeatureBento, SignalPath, LanguageWall, FinalCTA } from '../components/Landing/Landing';
import StructuredData from '../components/StructuredData.astro';
import { applicationSchema } from '../data/application';
import { languages } from '../data/languages';
import comparison from '../data/home-comparison.json';
import { freshVerification } from '../lib/content-verification';
import { repositoryStars } from '../lib/github-repo';
import '../styles/home.css';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
if (!freshVerification(comparison.verified)) throw new Error('Recheck Home comparison sources: verified must be within 120 UTC days.');
const rows = comparison.rows.map((row) => ({ ...row, cells: row.cells.map((cell) => ({ ...cell, verified: comparison.verified })) }));
const stars = await repositoryStars();
const compareGuides = [['wispr-flow-alternative/', 'Wispr Flow'], ['typeless-alternative/', 'Typeless'], ['superwhisper-alternative-windows/', 'Superwhisper'], ['windows-voice-typing-alternative/', 'Windows voice typing'], ['dragon-alternative/', 'Dragon']];
const privacyFacts = [
  { title: 'No cloud transcription', detail: 'Your audio is never sent to a server.' },
  { title: 'No account', detail: 'Nothing to sign up for or sign in to.' },
  { title: 'No telemetry', detail: 'No tracking or analytics — in the app or on this site.' },
  { title: 'Opt-in update checks', detail: 'Off by default, and they never include audio or text.' },
];
const questions = [
  { question: 'Does my voice leave my PC?', answer: 'Speech recognition and text cleanup run locally. Saydraft has no cloud transcription, telemetry, or account. Model downloads happen only when you start them during setup. Optional update checks are off by default and request public release information from GitHub without your audio or text.' },
  { question: 'Do I need the internet to get started?', answer: 'Yes, once: choose the recommended models, review their sizes and licenses, and start the setup download. You can pause and resume. Later launches reuse the installed models offline.' },
  { question: 'Which languages can I dictate in?', answer: `Highlighted choices are ${languages.map((language) => language.name).join(', ')}. Parakeet v3 covers 25 European languages; the other highlighted choices use the optional shared All languages model. There are no separate language packs. Choosing a language starts no download.` },
  { question: 'Do I need a powerful graphics card?', answer: 'Speech recognition can run on the CPU. Hardware and model choice affect speed; optional AI cleanup requires more resources. The performance check helps choose a suitable setup, including rules-only cleanup.' },
  { question: 'Where can I use it?', answer: 'Saydraft inserts text at the cursor in editable Windows apps. Password fields are excluded. Some protected or elevated apps need extra care; start with an ordinary text editor.' },
  { question: 'Can I change how my words are cleaned up?', answer: 'Choose a tone and cleanup intensity for each app group, add names to your dictionary, and create spoken snippets. Raw mode preserves your transcript without prose cleanup.' },
  { question: 'Is it free?', answer: 'Saydraft is free and open source under the MIT license. Speech and cleanup models have their own licenses, shown before download and listed in the project credits.' },
  { question: 'Is this page listening to me?', answer: 'No. The example is a canned simulation. This website does not request microphone access, upload audio, or use tracking analytics.' },
  { question: 'Is there a subscription word quota?', answer: 'No. Saydraft has no subscription word quota. Each dictation has a configurable recording cap, 20 minutes by default, with a warning at 19 minutes. That duration cap is separate from the words you can dictate across sessions.' },
  { question: 'Can it make meeting notes?', answer: 'Meeting notes are an experimental Pro hardware-profile feature with explicit model setup, device selection and recording consent. Full live/frozen workflows, a 30-minute meeting and broader speech, speaker and summary accuracy remain open acceptance work. Ordinary Scratchpad notes are separate.' },
];
---
<Base title="Saydraft: Free Offline AI Dictation for Windows" description={`Free offline dictation for Windows in ${languages.length} highlighted languages, including Arabic, Bengali, Chinese, Hindi, Japanese, Korean, Portuguese, Spanish and Thai. Open source and local.`} announcement={{ text: 'The Windows preview is here. Download Saydraft 0.1.0 — unsigned and free', mobileText: 'Windows preview available — unsigned and free', href: currentRelease.href }}>
  <main id="main" class="landing-v2">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-top eyebrow"><span><Mark size={12} />Offline dictation for Windows</span><span>Free · Open source · No account</span></div>
      <h1 id="hero-title">Speak <del class="filler"><span aria-hidden="true">um,</span><span class="sr-only">um,</span><span class="filler-label eyebrow" aria-hidden="true">— filler</span></del><span class="sr-only">(filler removed)</span> messy.<br /><span class="hero-second-line">Paste polished<span class="signal" aria-hidden="true">.</span><span class="sr-only">.</span></span></h1>
      <div class="hero-bottom"><p>Hold Ctrl + Win and talk the way you think. Saydraft tidies your words on your PC and types them wherever your cursor is.</p><div class="hero-actions"><div class="hero-buttons"><Button href="https://github.com/tanzir71/saydraft" variant="secondary">View source</Button><Button href={currentRelease.href}>Get Saydraft for Windows</Button></div><a class="mobile-source" href="https://github.com/tanzir71/saydraft">View source on GitHub ↗</a><p class="eyebrow muted"><span class="desktop-copy">Windows 10 &amp; 11 · Unsigned portable · Offline after setup</span><span class="mobile-copy">Unsigned Windows preview · Offline after setup</span></p></div></div>
      <InstrumentPanel />
    </section>
    <FactsSheet base={base} stars={stars} />
    <section class="home-section container" id="how-it-works" aria-labelledby="how-title"><SectionHeader number="01" label="How it works" id="how-title" title="Hold. Talk. Let go." description="No new app to learn. Saydraft sits in your tray and works in any editable Windows app — mail, docs, chat and your code editor." /><HowItWorks /></section>
    <section class="home-section container" id="cleanup" aria-labelledby="cleanup-title"><SectionHeader number="02" label="Cleanup" id="cleanup-title" description="After recognition, Saydraft removes hesitations, applies your corrections and formats lists — locally. Raw mode keeps every word."><Fragment slot="title">Say it your way.<br />We’ll tidy up.</Fragment></SectionHeader><ProofSheet /></section>
    <section class="home-section container tools-section" id="features" aria-labelledby="features-title"><SectionHeader number="03" label="Features" id="features-title" description="Tone per app, your own vocabulary, short spoken cues — the details that make dictation sound like you, kept on your PC."><Fragment slot="title">Built around<br />how you write.</Fragment></SectionHeader><FeatureBento /></section>
    <section class="privacy-sheet dark-sheet" id="privacy" aria-labelledby="privacy-title"><div class="container"><SectionHeader number="04" label="Privacy" id="privacy-title" description="Speech recognition and cleanup run locally. Installed models keep working with Wi-Fi off — and you can check that yourself."><Fragment slot="title">Your voice never<br />leaves your PC.</Fragment></SectionHeader><SignalPath /><PrivacyFacts facts={privacyFacts} /><div class="privacy-actions"><Button href={`${base}docs/privacy/verify-offline/`} variant="on-dark">Verify it offline yourself</Button><a href={`${base}privacy/`}>Read the privacy details ↗</a></div></div></section>
    <section class="home-section container comparison-section" id="compare" aria-labelledby="compare-title"><SectionHeader number="05" label="Compare" id="compare-title" description="How Saydraft compares with the dictation tools people most often switch from."><Fragment slot="title">A different kind<br />of deal.</Fragment></SectionHeader><CompareTable caption="Compare your everyday dictation setup" products={comparison.products} rows={rows} note={`Checked ${comparison.verified} against each product’s documentation. Features and plans change. Not affiliated with Wispr Flow, Typeless or Microsoft.`} /><nav class="compare-guides" aria-label="Detailed dictation comparisons">{compareGuides.map(([path, name]) => <a href={`${base}${path}`}>{name} ↗</a>)}</nav></section>
    <section class="home-section container" id="languages" aria-labelledby="languages-title"><SectionHeader number="06" label="Languages" id="languages-title" description="Parakeet v3 covers 25 European languages. One shared “All languages” model adds the rest. Install once, then dictate offline."><Fragment slot="title">Your words,<br />your language.</Fragment></SectionHeader><LanguageWall base={base} /><p class="language-accuracy muted">Coverage and measured accuracy are separate. Review results for your accent, names and recording conditions.</p></section>
    <section class="home-section container faq-section" id="questions" aria-labelledby="faq-title"><div class="faq-intro"><p class="eyebrow section-rule">07 — Questions</p><h2 id="faq-title">Glad you<br />asked.</h2><p>Still curious? Read the docs or open an issue on GitHub — the whole project is in the open.</p><div><a href={`${base}docs/`}>Read the docs ↗</a><a href="https://github.com/tanzir71/saydraft/issues">GitHub issues ↗</a></div></div><FAQ questions={questions} openFirst /></section>
    <FinalCTA base={base} />
  </main>
  <StructuredData data={applicationSchema(Astro.site!, base)} />
  <StructuredData data={{ '@type': 'FAQPage', mainEntity: questions.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) }} />
  <script>
    import { installLanding } from '../scripts/landing';
    installLanding();
  </script>
</Base>
