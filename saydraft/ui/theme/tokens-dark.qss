/* Generated by tools/generate_tokens.mjs; edit design/tokens.json. */
QWidget { background-color: #111111; color: #F5F2E9; }
QLabel, QCheckBox, QRadioButton { background: transparent; }
QToolTip, QMenu, QGroupBox { background-color: #1C2740; color: #F5F2E9; }
QGroupBox { border: none; border-radius: 12px; margin-top: 20px; padding: 16px; }
QGroupBox::title { subcontrol-origin: margin; padding-left: 8px; }
QWidget#dictionaryToast { background-color: #1C2740; border-radius: 20px; }
QTabWidget::pane { border: none; }
QCheckBox, QRadioButton { border: 2px solid transparent; padding: 2px; }
QCheckBox:focus, QRadioButton:focus { border-color: #F5F2E9; border-radius: 4px; }
QCheckBox::indicator, QRadioButton::indicator { width: 18px; height: 18px; background: #1C2740; border: 1px solid #B9B6AC; border-radius: 4px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked { background: #DDE6F6; border-color: #DDE6F6; image: url(saydraftTheme:check-dark.svg); }
QRadioButton::indicator:checked { image: url(saydraftTheme:radio-dark.svg); }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
  background-color: #1C2740; color: #F5F2E9; border: 2px solid transparent;
  border-radius: 8px; padding: 6px; selection-background-color: #DDE6F6;
  selection-color: #141414;
}
QPushButton { background-color: #1C2740; color: #F5F2E9; border: 2px solid transparent; border-radius: 12px; padding: 8px 14px; }
QPushButton[primary="true"], QPushButton:checked { background-color: #DDE6F6; color: #141414; }
QPushButton:hover { background-color: #DDE6F6; color: #141414; }
QPushButton:focus, QLineEdit:focus, QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
  border: 2px solid #F5F2E9;
}
QWidget:disabled { color: #B9B6AC; }
QLabel[role="muted"] { color: #B9B6AC; }
QLabel[role="display"] { font-family: "Instrument Serif"; font-size: 34px; }
QLabel[role="eyebrow"] { font-family: "Geist Mono"; font-size: 12px; }
QProgressBar { border: none; background-color: #1C2740; color: #F5F2E9; selection-color: #141414; selection-background-color: #DDE6F6; border-radius: 6px; text-align: center; }
QProgressBar::chunk { background-color: #F5F2E9; border-radius: 6px; }
QTabBar::tab { padding: 10px 16px; background-color: #111111; color: #B9B6AC; }
QTabBar::tab:selected { background-color: #1C2740; color: #F5F2E9; }
QScrollArea, QFrame { border: none; }
QHeaderView::section { background-color: #1C2740; color: #F5F2E9; border: none; padding: 8px; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url(saydraftTheme:down-dark.svg); width: 12px; height: 8px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; border: none; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; border: none; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(saydraftTheme:up-dark.svg); width: 10px; height: 6px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(saydraftTheme:down-dark.svg); width: 10px; height: 6px; }
