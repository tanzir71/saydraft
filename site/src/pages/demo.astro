---
import Base from '../layouts/Base.astro';
import { BarDemo } from '../components/BarDemo/BarDemo';
import { KeyCaps } from '../components/KeyCaps/KeyCaps';
import { Button } from '../components/Button/Button';
import examples from '../data/demo.json';
import '../styles/demo.css';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<Base title="Saydraft Demo — Illustrative Dictation and Cleanup" description="Explore four prepared raw-to-clean dictation examples. This Saydraft simulation uses no microphone, models, uploads, clipboard or text insertion." noindex>
  <main id="main" class="container demo-page">
    <p class="eyebrow">A little room to try an idea</p>
    <h1>From a rough thought.<br /><em>To a clear draft.</em></h1>
    <p class="demo-intro">Choose an example. Watch the words settle into place.</p>
    <p class="demo-notice">Illustrative simulation · no microphone</p>
    <p class="demo-explainer">Every sentence and result here is prepared in advance. This page does not record, run speech or cleanup models, upload words, use your clipboard or insert text into an app. Actual results depend on your speech, settings and installed models.</p>
    <fieldset class="demo-lab" data-demo-lab>
      <legend>Choose an example</legend>
      <div class="demo-choices">{examples.map((example, index) => <label><input type="radio" name="demo-example" value={example.id} checked={index === 0} /><span>{example.label}</span></label>)}</div>
      <div class="demo-stage"><BarDemo state="idle" /><p role="status" aria-live="polite" aria-atomic="true" data-demo-announcement>Ready. Choose an example to read its prepared draft.</p></div>
      {examples.map((example) => <section class="demo-example" data-sample={example.id} aria-labelledby={`demo-${example.id}`}>
        <h2 id={`demo-${example.id}`}>{example.label}</h2>
        <div class="demo-words"><details open><summary>Raw words</summary><p>{example.raw}</p></details><div class="demo-draft"><h3>Prepared draft</h3><p data-clean>{example.clean}</p></div></div>
      </section>)}
      <div class="demo-controls" data-demo-controls hidden><button type="button" data-demo-run>Play example <span aria-hidden="true">↗</span></button><button type="button" class="demo-reset" data-demo-reset>Reset example</button></div>
      <noscript><p class="demo-nojs">Choose an example to read the prepared text. Raw words open and close without JavaScript; playing the animation needs JavaScript.</p></noscript>
    </fieldset>
    <section class="demo-next" aria-labelledby="demo-next-title"><div><p class="eyebrow">For your own words</p><h2 id="demo-next-title">Keep it on<br /><em>your machine.</em></h2><p>In the Windows app, hold <KeyCaps keys={['Ctrl', 'Win']} /> to dictate after setup. This page only plays the prepared examples above.</p></div><Button href={`${base}download/`}>Review setup for Windows</Button></section>
  </main>
  <script>
    import { installDemo } from '../lib/demo';
    installDemo();
  </script>
</Base>
