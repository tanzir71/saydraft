---
import '../styles/global.css';
import { NavPill } from '../components/NavPill/NavPill';
import { Footer } from '../components/Footer/Footer';
import { AnnouncementBar } from '../components/AnnouncementBar/AnnouncementBar';
import bodyFace from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import displayFace from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import italicFace from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import { socialImagePath, verificationToken } from '../lib/seo';
interface Props { title: string; description: string; noindex?: boolean; canonicalPath?: string; announcement?: { text: string; href: string }; }
const { title, description, noindex = false, canonicalPath = Astro.url.pathname, announcement } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonical = new URL(canonicalPath, Astro.site);
const image = new URL(socialImagePath(canonical.pathname, base), Astro.site).href;
const google = verificationToken(import.meta.env.GOOGLE_SITE_VERIFICATION, 'google');
const bing = verificationToken(import.meta.env.BING_SITE_VERIFICATION, 'bing');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F2E9" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Saydraft" />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — Saydraft page preview`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={`${title} — Saydraft page preview`} />
    {google && <meta name="google-site-verification" content={google} />}
    {bing && <meta name="msvalidate.01" content={bing} />}
    {noindex ? <meta name="robots" content="noindex,follow" /> : null}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap-index.xml`} />
    <link rel="icon" href={`${base}favicon.svg?v=2`} type="image/svg+xml" />
    {[bodyFace, displayFace, italicFace].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />)}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {announcement && <AnnouncementBar href={announcement.href}>{announcement.text}</AnnouncementBar>}
    <NavPill base={base} />
    <slot />
    <Footer base={base} />
    <script>
      import { installCopyButtons } from '../scripts/copy';
      installCopyButtons();
    </script>
  </body>
</html>
