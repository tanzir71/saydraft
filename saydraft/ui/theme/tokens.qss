/* Generated by tools/generate_tokens.mjs; edit design/app-tokens.json. */
/* Font sizes/weights are applied from live application-font ratios, not frozen px. */
QWidget { background-color: #E9E8E3; color: #0F0F0E; }
QWidget[bare="true"] { background: transparent; }
QLabel, QCheckBox, QRadioButton, QToolButton { background: transparent; }
QFrame, QScrollArea { border: none; }
QFrame[card="true"], QWidget[card="true"] { background: #F6F6F2; border: 1px solid rgba(15,15,14,26); border-radius: 14px; }
QFrame[modelChoice="true"][selected="true"] { border: 2px solid #0F0F0E; }
QWizardPage { background: #F6F6F2; }
QFrame[field="true"] { background: #E9E8E3; border-radius: 10px; }
QFrame[row="true"] { background: transparent; border-top: 1px solid rgba(15,15,14,26); }
QFrame[rowFirst="true"] { border: none; }
QLabel[role="muted"], QLabel[role="small"], QLabel[role="caption"], QLabel[role="label"], QLabel[role="eyebrow"] { color: #63625D; }
QLabel[role="title"], QLabel[role="setupTitle"], QLabel[role="heading"], QLabel[role="display"] { font-family: "Familjen Grotesk"; }
QLabel[role="label"], QLabel[role="eyebrow"] { font-family: "Martian Mono"; }
QLabel[role="readout"] { font-family: "Doto"; }
QLabel[keycap="true"] { color: #0F0F0E; background: #F6F6F2; border: 1px solid rgba(15,15,14,26); border-bottom-width: 2px; border-radius: 6px; padding: 2px 7px; min-height: 16px; }
QLabel[keycap="true"][bar="true"] { background: #232321; color: #EDEDE8; border-color: rgba(237,237,232,31); }
QLabel[badge] { border-radius: 11px; padding: 3px 9px 3px 8px; background: #E9E8E3; color: #63625D; }
QLabel[badge="signal"] { background: #FFD8CC; color: #B3361C; }
QLabel[badge="ok"] { background: #D7EBDD; color: #28704A; }
QLabel[badge="warn"] { background: #F7E3C6; color: #944A08; }
QLabel[badge="danger"] { background: #F8D9D4; color: #B42318; }
QPushButton { background: transparent; color: #0F0F0E; border: 1px solid rgba(15,15,14,26); border-radius: 18px; padding: 7px 16px; min-height: 20px; }
QPushButton[size="s"] { border-radius: 15px; padding: 5px 12px; min-height: 18px; }
QPushButton[primary="true"] { background: #0F0F0E; color: #F6F6F2; border: 1px solid #0F0F0E; }
QPushButton[ghost="true"] { border-color: transparent; }
QPushButton[danger="true"] { background: #F8D9D4; color: #B42318; border-color: transparent; }
QPushButton:hover, QToolButton:hover { background: #DEDDD7; }
QPushButton[primary="true"]:hover { background: #63625D; border-color: #63625D; }
QPushButton:disabled, QToolButton:disabled { color: #9A9993; }
QPushButton[primary="true"]:disabled { background: #DEDDD7; border-color: #DEDDD7; color: #9A9993; }
QPushButton:focus, QToolButton:focus, QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus { border: 2px solid #0F0F0E; }
QToolButton { border: 1px solid transparent; border-radius: 8px; padding: 6px; }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #E9E8E3; color: #0F0F0E; border: 2px solid transparent; border-radius: 10px; padding: 6px 10px; min-height: 20px; selection-background-color: #0F0F0E; selection-color: #F6F6F2; }
QLineEdit[search="true"] { background: #F6F6F2; border: 1px solid rgba(15,15,14,26); }
QLineEdit[search="true"]:focus { border: 2px solid #0F0F0E; }
QTextEdit[reader="true"], QPlainTextEdit[reader="true"] { background: transparent; border: none; padding: 0; }
QTextEdit[reader="true"]:focus, QPlainTextEdit[reader="true"]:focus { border: 2px solid #0F0F0E; }
QFrame[segmented="true"] { background: #E9E8E3; border-radius: 10px; }
QFrame[segmented="true"][onBackground="true"] { background: #DEDDD7; }
QRadioButton[segment="true"], QPushButton[segment="true"] { background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 5px 12px; color: #63625D; }
QRadioButton[segment="true"]::indicator { width: 0; height: 0; border: none; }
QRadioButton[segment="true"]:checked, QPushButton[segment="true"]:checked { background: #F6F6F2; color: #0F0F0E; }
QRadioButton[segment="true"]:focus, QPushButton[segment="true"]:focus { border: 2px solid #0F0F0E; }
QGroupBox { background: #F6F6F2; border: 1px solid rgba(15,15,14,26); border-radius: 14px; margin-top: 20px; padding: 16px; }
QGroupBox::title { subcontrol-origin: margin; padding-left: 8px; }
QWidget#dictionaryToast { background: #F6F6F2; border: 1px solid rgba(15,15,14,26); border-radius: 14px; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: #E9E8E3; color: #63625D; padding: 8px 12px; }
QTabBar::tab:selected { background: #F6F6F2; color: #0F0F0E; }
QListWidget { background: transparent; border: 2px solid transparent; border-radius: 10px; selection-background-color: #E9E8E3; selection-color: #0F0F0E; }
QListWidget:focus { border-color: transparent; }
QListWidget::item:focus { border-color: #0F0F0E; }
QListWidget::item { padding: 8px 10px; border: 1px solid transparent; border-radius: 10px; color: #63625D; }
QListWidget::item:selected { background: #F6F6F2; color: #0F0F0E; border-color: rgba(15,15,14,26); }
QPushButton[navButton="true"] { text-align: left; border-radius: 10px; padding: 8px 10px; }
QPushButton[navButton="true"]:checked { background: #F6F6F2; color: #0F0F0E; border: 1px solid rgba(15,15,14,26); }
QPushButton[navButton="true"]:focus { border: 2px solid #0F0F0E; }
QListWidget#hubNavigation::item { min-height: 18px; padding: 8px 10px; }
QListWidget#settingsSections::item { min-height: 16px; padding: 6px 12px; border-radius: 8px; }
QListWidget#settingsSections::item:selected { background: #F6F6F2; }
QListWidget[results="true"] { background: #F6F6F2; }
QListWidget[results="true"]::item:selected { background: #E9E8E3; border-color: transparent; }
QListWidget[languageTiles="true"]::item { background: #F6F6F2; border: 1px solid rgba(15,15,14,26); border-radius: 10px; padding: 12px; }
QListWidget[languageTiles="true"]::item:checked { background: #FFD8CC; color: #B3361C; }
QListWidget[languageTiles="true"]::indicator { width: 18px; height: 18px; background: #F6F6F2; border: 1px solid #63625D; border-radius: 4px; }
QListWidget[languageTiles="true"]::indicator:checked { background: #0F0F0E; border-color: #0F0F0E; image: url(saydraftTheme:check-light.svg); }
QTableView, QTreeView { background: #F6F6F2; alternate-background-color: #F6F6F2; selection-background-color: #E9E8E3; selection-color: #0F0F0E; gridline-color: transparent; border: none; }
QHeaderView::section { background: #F6F6F2; color: #63625D; border: none; border-bottom: 1px solid rgba(15,15,14,26); padding: 10px 16px; }
QCheckBox, QRadioButton { border: 2px solid transparent; padding: 2px; }
QCheckBox:focus, QRadioButton:focus { border-color: #0F0F0E; border-radius: 4px; }
QCheckBox::indicator, QRadioButton::indicator { width: 18px; height: 18px; background: #F6F6F2; border: 1px solid #63625D; border-radius: 4px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked { background: #0F0F0E; border-color: #0F0F0E; image: url(saydraftTheme:check-light.svg); }
QRadioButton::indicator:checked { image: url(saydraftTheme:radio-light.svg); }
QCheckBox[toggle="true"] { border: none; padding: 0; }
QCheckBox[toggle="true"]::indicator { width: 0; height: 0; border: none; }
QWidget:disabled { color: #9A9993; }
QProgressBar { border: none; background: #DEDDD7; border-radius: 3px; text-align: center; }
QProgressBar::chunk { background: #0F0F0E; border-radius: 3px; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url(saydraftTheme:down-light.svg); width: 12px; height: 12px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; border: none; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; border: none; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(saydraftTheme:up-light.svg); width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(saydraftTheme:down-light.svg); width: 10px; height: 10px; }
QMenu { background: #F6F6F2; color: #0F0F0E; border: 1px solid rgba(15,15,14,26); border-radius: 10px; padding: 6px 0; }
QMenu::item { padding: 8px 14px 8px 12px; }
QMenu::item:selected { background: #E9E8E3; }
QMenu::separator { height: 1px; background: rgba(15,15,14,26); margin: 4px 0; }
QToolTip { background: #0F0F0E; color: #F6F6F2; border: none; border-radius: 6px; padding: 4px 8px; }
QScrollBar:vertical { width: 10px; background: transparent; }
QScrollBar::handle:vertical { background: #DEDDD7; border-radius: 5px; min-height: 32px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QFrame[saveBar="true"] { background: #0F0F0E; color: #F6F6F2; border-radius: 24px; }
QFrame[saveBar="true"] QLabel { color: #F6F6F2; }
QFrame[saveBar="true"] QPushButton { color: #F6F6F2; border-color: transparent; }
QFrame[saveBar="true"] QPushButton[primary="true"] { background: #F6F6F2; color: #0F0F0E; border-color: #F6F6F2; }
QFrame[saveBar="true"] QPushButton:focus { border: 2px solid #F6F6F2; }
QFrame[inverse="true"] { background: #0F0F0E; color: #F6F6F2; border-radius: 14px; }
QFrame[inverse="true"] QLabel { color: #F6F6F2; background: transparent; }
QFrame[setupStage="true"] { background: #E9E8E3; border-radius: 16px; }
QFrame[preview="true"] { background: #F6F6F2; border: 1px solid #0F0F0E; border-radius: 12px; }
