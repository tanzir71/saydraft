# Auto detect text files and perform LF normalization
* text=auto
*.wav binary

# Preserve byte-for-byte checksums for bundled model notices.
assets/licenses/*.txt text eol=lf
assets/licenses/qwen35-Apache-2.0.txt -text
assets/licenses/*.pdf binary
# Upstream package notices retain their original bytes and line endings.
assets/licenses/packaged/** -text -whitespace

# Derived frequency data and its provenance retain their pinned bytes.
assets/dictionary/frequency/*.gz binary
assets/dictionary/frequency/*.txt -text
# These unchanged upstream texts include trailing blank lines.
assets/dictionary/frequency/CC-BY-SA-4.0.txt -text whitespace=-blank-at-eof
assets/dictionary/frequency/wordfreq-NOTICE.md -text whitespace=-blank-at-eof
assets/dictionary/frequency/manifest.json -text

# Unmodified font binaries, licenses and provenance retain pinned source bytes.
assets/fonts/** -text
assets/fonts/**/*.ttf binary
assets/fonts/**/OFL.txt whitespace=-blank-at-eof,-blank-at-eol

# Preserve original Fontsource license notices served by the static site.
site/public/licenses/*.txt -text whitespace=-blank-at-eof,-blank-at-eol

# Native measurement reports retain their recorded SHA-256 across checkouts.
eval/cleanup/results/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eval/hardware/results/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eval/soak/results/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eval/packaging/results/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eval/packaging/results/**/*.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eval/updates/results/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eval/privacy/results/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eval/privacy/results/**/*.jsonl -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eval/latency/results/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eval/latency/results/**/*.jsonl -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
