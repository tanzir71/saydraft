---
import '../styles/global.css';
import { NavPill } from '../components/NavPill/NavPill';
import { Footer } from '../components/Footer/Footer';
import bodyFace from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import displayFace from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import italicFace from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F2E9" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {noindex ? <meta name="robots" content="noindex,follow" /> : null}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <link rel="icon" href={`${base}favicon.svg?v=2`} type="image/svg+xml" />
    {[bodyFace, displayFace, italicFace].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />)}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <NavPill base={base} />
    <slot />
    <Footer base={base} />
    <script>
      import { installCopyButtons } from '../scripts/copy';
      installCopyButtons();
    </script>
  </body>
</html>
